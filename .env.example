# compose.yaml uses demo-only credentials and internal service names by default.
# For native development, start MySQL yourself and export these for the backend:
DB_URL=jdbc:mysql://localhost:3306/studio?serverTimezone=UTC
DB_USER=studio
DB_PASSWORD=studio-local
STORAGE_DIR=./data
ALLOWED_ORIGIN=http://localhost:3000
SIMULATION_ENABLED=true
# Native frontend development only (Compose Dockerfile bakes in backend:8080):
API_INTERNAL_URL=http://localhost:8080
